<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.club.clubsystem.mapper.ClubMapper">
    <!-- 多字段动态SQL，三表：club、student、club_member -->
    <select id="selectClubByCondition" resultType="Club">
        SELECT DISTINCT c.*, s.stu_name AS leader_name
        FROM club c
        LEFT JOIN student s ON c.leader_id = s.id
        LEFT JOIN club_member cm ON c.id = cm.club_id
        <where>
            <if test="clubType != null and clubType != ''">
                c.club_type = #{clubType}
            </if>
            <if test="stuName != null and stuName != ''">
                AND s.stu_name LIKE CONCAT('%',#{stuName},'%')
            </if>
            <!-- 成员身份筛选条件 来自club_member表 -->
            <if test="memberRole != null and memberRole != ''">
                AND cm.role = #{memberRole}
            </if>
        </where>
    </select>
</mapper>